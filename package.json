{
  "private": true,
  "name": "strike-limit",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "checks": "npm run lint && npm run format:check && npm run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test",
    "lint:fix": "oxlint src test --fix",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "build": "vite build",
    "deploy": "npm run build && devvit upload",
    "dev": "vite build && devvit playtest",
    "login": "devvit login",
    "launch": "npm run build && npm run deploy && devvit publish"
  },
  "engines": {
    "node": ">=24.18"
  },
  "dependencies": {
    "@devvit/web": "0.14.7",
    "@hono/node-server": "^2.1.3",
    "devvit": "0.14.7",
    "hono": "^4.13.13",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@devvit/start": "^0.14.7",
    "@devvit/test": "0.14.7",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "<6.1.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
