{
  "private": true,
  "name": "strike-limit",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "checks": "npm run lint && npm run type-check",
    "lint": "eslint src",
    "type-check": "tsc --noEmit -p .",
    "prettier": "npx prettier -w src",
    "build": "vite build",
    "deploy": "npm run build && devvit upload",
    "dev": "vite build && devvit playtest",
    "login": "devvit login",
    "launch": "npm run build && npm run deploy && devvit publish"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@devvit/public-api": "^0.14.6",
    "@devvit/web": "0.14.6",
    "@hono/node-server": "^2.1.3",
    "devvit": "0.14.6",
    "hono": "^4.13.13",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@devvit/start": "^0.14.6",
    "@eslint/js": "^10.0.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
