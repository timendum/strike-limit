{
  "private": true,
  "name": "strike-limit",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "checks": "npm run lint && npm run type-check",
    "lint": "eslint src",
    "type-check": "tsc --noEmit -p .",
    "prettier": "npx prettier -w src",
    "build": "vite build",
    "deploy": "npm run build && devvit upload",
    "dev": "vite build && devvit playtest",
    "login": "devvit login",
    "launch": "npm run build && npm run deploy && devvit publish"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@devvit/public-api": "^0.12.22",
    "@devvit/web": "0.12.22",
    "@hono/node-server": "^1.19.13",
    "devvit": "0.12.22",
    "hono": "^4.12.12",
    "temporal-polyfill": "^0.3.2"
  },
  "devDependencies": {
    "@devvit/start": "^0.12.22",
    "@eslint/js": "^10.0.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.7"
  }
}
