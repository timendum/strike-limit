{
  "private": true,
  "name": "strike-limit",
  "version": "0.1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "checks": "npm run lint && npm run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "prettier": "npx prettier -w src",
    "build": "vite build",
    "deploy": "npm run build && devvit upload",
    "dev": "vite build && devvit playtest",
    "login": "devvit login",
    "launch": "npm run build && npm run deploy && devvit publish"
  },
  "engines": {
    "node": ">=24.18"
  },
  "dependencies": {
    "@devvit/web": "0.14.7",
    "@hono/node-server": "^2.1.3",
    "devvit": "0.14.7",
    "hono": "^4.13.13",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@devvit/start": "^0.14.7",
    "@devvit/test": "0.14.7",
    "@eslint/js": "^10.0.1",
    "prettier": "^3.9.9",
    "typescript": "<6.1.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
